FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PLAYWRIGHT_BROWSERS_PATH=/opt/browsers
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates ffmpeg nodejs postgresql-client \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY pyproject.toml README.md ./
COPY worker ./worker
RUN python -m pip install '.[dev]' 'playwright==1.58.0' \
    && python -m playwright install --with-deps chromium
COPY scripts ./scripts
COPY migrations ./migrations
COPY tests ./tests
COPY ui ./ui
COPY maintenance ./maintenance
COPY build-manifest.json ./build-manifest.json
RUN chmod -R a+rX /app
ENTRYPOINT ["python", "-m", "maintenance.cli"]
