FACE_PROJECT_ID=teak-banner-dome
FACE_BUCKET=teak-banner-dome-bulk-videos
FACE_SOURCE_PREFIX=videos/
FACE_STAGING_PREFIX=face-staging/
FACE_CSEK_FILE=/workspaces/ThunderCloud/.secrets/gcs-csek.base64
# Remote Batch uses FACE_CSEK_SECRET=face-batch-gcs-csek instead of FACE_CSEK_FILE.
FACE_CLOUD_SQL_INSTANCE=teak-banner-dome:us-central1:face-batch-pg
FACE_CLOUD_SQL_IP_TYPE=PUBLIC
FACE_DB_USER=developer@example.com
FACE_DB_NAME=face_index
FACE_DETECTOR_MODEL=/workspaces/ThunderCloud/face-batch-gcp-scaffold/models/scrfd.onnx
FACE_EMBEDDING_MODEL=/workspaces/ThunderCloud/face-batch-gcp-scaffold/models/adaface.onnx
FACE_EMBEDDING_COLOR_ORDER=BGR
FACE_OUTPUT_DIR=/workspaces/ThunderCloud/face-batch-gcp-scaffold/data
FACE_DETECTOR_FPS=8
FACE_MAX_VIDEO_BYTES=10737418240
FACE_BEST_N=5
FACE_TOP_K=5
FACE_MATCH_THRESHOLD=0.55
FACE_MATCHING_ENABLED=true
FACE_THRESHOLD_VERSION=unvalidated-v1
