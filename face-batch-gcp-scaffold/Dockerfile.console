FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PATH=/opt/venv/bin:$PATH

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml README.md ./
COPY worker ./worker
COPY ui ./ui
RUN python -m venv /opt/venv \
    && python -m pip install --upgrade pip \
    && python -m pip install \
       'cloud-sql-python-connector[pg8000]>=1.16,<2' \
       'flask>=3.1,<4' 'google-cloud-secret-manager>=2.25,<3' \
       'google-cloud-storage>=3,<4' 'gunicorn>=23,<24' \
    && python -m pip install --no-deps .

RUN useradd --create-home --uid 10001 console
USER console

CMD ["gunicorn", "--bind=0.0.0.0:8080", "--workers=2", "--access-logfile=-", "worker.console:create_app()"]
